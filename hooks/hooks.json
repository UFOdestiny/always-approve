{
  "description": "Answers Claude Code and Codex permission prompts according to the configured approval policy.",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/always_approve.py\"",
            "timeout": 5,
            "statusMessage": "Checking configured approval policy"
          }
        ]
      }
    ]
  }
}
